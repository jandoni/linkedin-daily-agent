# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to  config.env  and fill in the real values.  config.env is
# gitignored and must NEVER be committed.  See README.md for where each comes from.
# ─────────────────────────────────────────────────────────────────────────────

# ── n8n credential IDs ──────────────────────────────────────────────────────
# Create these credentials in the n8n UI first (Settings → Credentials), then
# copy each credential's ID from its URL (…/credentials/<ID>). They differ on
# every install, so you MUST regenerate the workflows after creating them.
LINKEDIN_CRED=your_linkedin_oauth2_credential_id
TELEGRAM_CRED=your_telegram_api_credential_id
CLAUDE_CRED=your_anthropic_header_auth_credential_id     # x-api-key header auth

# ── identities ──────────────────────────────────────────────────────────────
CHAT_ID=your_telegram_chat_id                 # message @userinfobot, or getUpdates
PERSON_URN=your_linkedin_person_urn           # the 'sub' from GET https://api.linkedin.com/v2/userinfo
LINKEDIN_HANDLE=your-handle                    # the slug in linkedin.com/in/<slug>/ — shown on the card + video watermark
DISPLAY_NAME=Your Name                          # full name shown on the social-post card style
AUTHOR_BIO="a cloud product leader and former SRE"   # one line about you; the drafting prompt says "You are <DISPLAY_NAME>, <AUTHOR_BIO>"
TIMEZONE=America/Chicago                        # IANA time zone for the timestamp on post-screenshot cards
AVATAR_URL=                                      # optional profile photo URL for the social-post card; blank = monogram initials
X_HANDLE=                                        # optional: your real X handle (no @) for the post-screenshot card; blank = shows in/<LINKEDIN_HANDLE>
VERIFIED_BADGE=1                                 # blue check next to your name on the post-screenshot card (0 = off)
TG_TOKEN=your_telegram_bot_token              # from @BotFather (e.g. 12345:AA...)

CONTACT_EMAIL=you@example.com                 # polite UA contact for the Wikipedia image API

# ── n8n instance (used by import_workflows.py) ──────────────────────────────
N8N_URL=http://<n8n-host>:5678
N8N_EMAIL=you@example.com                      # n8n owner login
N8N_PASSWORD=your_n8n_owner_password
WF_A_ID=                                       # leave BLANK on first import (a new workflow is created);
WF_B_ID=                                       # paste the printed IDs back here to update later.
